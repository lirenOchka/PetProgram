<Window x:Class="tamogoji.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="tamogoji"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <Grid>
        <Canvas x:Name="MainCanvas" Background="Transparent">
            <Image x:Name="pet"
                   Width="275" Height="355"
                   RenderTransformOrigin="0.5,0.5"
                   MouseLeftButtonDown="Pet_MouseLeftButtonDown"
                   MouseLeftButtonUp="Pet_MouseLeftButtonUp"
                   MouseMove="Pet_MouseMove"
                   MouseLeave="Pet_MouseLeave"
                   MouseRightButtonUp="Pet_MouseRightButtonUp"/>
        </Canvas>
    </Grid>
</Window>