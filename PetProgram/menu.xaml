<Window x:Class="tamogoji.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Menu" Width="500" Height="510"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Background>
        <ImageBrush ImageSource="/image/fon.jpg" Stretch="Fill" ViewportUnits="Absolute" TileMode="Tile" Viewport=" 0,00,75,75">
            <ImageBrush.Transform>
                <TranslateTransform x:Name="imgShiftMen"/>
            </ImageBrush.Transform>
        </ImageBrush>
    </Window.Background>
    <Grid>
        <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
        <Border Grid.Column="0" Grid.Row="0" Margin="5" CornerRadius="5" BorderThickness="3" BorderBrush="#711265">
            <Border.Background >
                <ImageBrush ImageSource="/image/dialogFon.png" Stretch="Fill" ViewportUnits="Absolute" TileMode="Tile" Viewport=" 0,5,40,40">
                    <ImageBrush.Transform>
                        <TranslateTransform/>
                    </ImageBrush.Transform>
                </ImageBrush>
            </Border.Background>
            <Button Background="Transparent"
                   MouseLeave="aniStop"
                   MouseEnter="aniRun"
                   BorderBrush="Transparent"
                   Click="DialogButtonClick"
                    >
                <Button.Content>
                    <Image x:Name="imageDialog" Source="/image/buttonsText/dialogueButtonText.png" Margin="12"/>
                </Button.Content>
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Border>

        <!--кнопка выхода-->
        <Border Grid.Column="1" Grid.Row="4" Margin="5" CornerRadius="5" BorderThickness="3" BorderBrush="#711265">
            <Border.Background >
                <ImageBrush ImageSource="/image/nullFon.png" Stretch="Fill" ViewportUnits="Absolute" TileMode="Tile" Viewport=" 0,0,40,40">
                    <ImageBrush.Transform>
                        <TranslateTransform/>
                    </ImageBrush.Transform>
                </ImageBrush>
            </Border.Background>
            <Button Background="Transparent"
                   MouseLeave="aniStop"
                   MouseEnter="aniRun"
                   BorderBrush="Transparent"
                   Click="ExitButtonClick"
            >
                <Button.Content>
                    <Image x:Name="imageExit" Source="/image/buttonsText/dialogueButtonText.png" Margin="12"/>
                </Button.Content>
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Border>
        
        
    </Grid>
</Window>