<Window x:Class="tamogoji.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Menu" Width="500" Height="510"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <!--
    Псевдокод (план):
    1. Для кнопки определить локальный Style.
    2. В Style установить начальные значения: Background=Transparent, Opacity=1.
    3. Добавить Trigger по свойству IsMouseOver:
       - при IsMouseOver=True установить Opacity=0 (кнопка визуально прозрачна).
    4. Сохранить существующие обработчики MouseEnter/MouseLeave (они продолжат работать).
    5. При желании можно заменить Setter на анимацию для плавного перехода (BeginStoryboard).
    -->
    <Window.Background>
        <ImageBrush ImageSource="/image/fon.jpg" Stretch="Fill" ViewportUnits="Absolute" TileMode="Tile" Viewport=" 0,00,75,75">
            <ImageBrush.Transform>
                <TranslateTransform x:Name="imgShiftMen"/>
            </ImageBrush.Transform>
        </ImageBrush>
    </Window.Background>
    <Grid>
        <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
        <Border Grid.Column="0" Grid.Row="0" Margin="5" CornerRadius="5" BorderThickness="3" BorderBrush="#711265">
            <Border.Background >
                <ImageBrush ImageSource="/image/dialogFon.png" Stretch="Fill" ViewportUnits="Absolute" TileMode="Tile" Viewport=" 0,5,40,40">
                    <ImageBrush.Transform>
                        <TranslateTransform x:Name="imgShiftDig"/>
                    </ImageBrush.Transform>
                </ImageBrush>
            </Border.Background>
            <Button Background="Transparent" 
                   MouseLeave="aniDigStop"
                   MouseEnter="aniDigRun"
                    >
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Opacity" Value="1"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Border>
    </Grid>
</Window>